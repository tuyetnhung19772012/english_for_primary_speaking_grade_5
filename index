        async function confirmRenameTopic() {
            const oldName = document.getElementById('selectRenameTarget').value;
            const newName = document.getElementById('inputRenameTopic').value.trim();

            if (!oldName) return;
            if (!newName) {
                alert("Please enter a new deck name!");
                document.getElementById('inputRenameTopic').focus();
                return;
            }
            if (oldName === newName) {
                closeRenameTopicPanel();
                return;
            }

            const existingTopics = getUniqueTopics();
            const isDifferentCaseOnly = oldName.toLowerCase() === newName.toLowerCase();
            const targetAlreadyExists = !isDifferentCaseOnly && existingTopics.some(t => t.toLowerCase() === newName.toLowerCase());

            if (targetAlreadyExists) {
                const confirmed = confirm(`A deck named "${newName}" already exists. Do you want to merge all cards from "${oldName}" into "${newName}"?`);
                if (!confirmed) return;
            }

            lessons.forEach(card => {
                if (card.topic.trim().toLowerCase() === oldName.toLowerCase()) {
                    card.topic = newName;
                }
            });

            const currentFilter = document.getElementById('filterAdminTopic').value;
            const nextFilter = (currentFilter === oldName.toLowerCase()) ? newName.toLowerCase() : currentFilter;

            const currentAddSelect = document.getElementById('selectTopic').value;
            const nextAddSelect = (currentAddSelect.toLowerCase() === oldName.toLowerCase()) ? newName : currentAddSelect;

            closeRenameTopicPanel();
            populateTopicDropdowns(nextAddSelect, nextFilter);
            renderAdminLessons();
            renderTopics();

            await persistAllLessons(`Renamed deck "${oldName}" to "${newName}"!`);
        }

