            if (cfg && cfg.owner && cfg.repo && cfg.token) {
                try {
                    const apiUrl = `https://api.github.com/repos/${encodeURIComponent(cfg.owner)}/${encodeURIComponent(cfg.repo)}/contents/${(cfg.path || 'index.html').replace(/^\/+/, '')}?ref=${encodeURIComponent(cfg.branch || 'main')}&_t=${Date.now()}`;
                    const ghRes = await fetch(apiUrl, {
                        cache: 'no-store',
                        headers: {
                            'Authorization': `Bearer ${cfg.token}`,
                            'Accept': 'application/vnd.github+json'
                        }
                    });
                    if (ghRes.ok) {
                        const fileData = await ghRes.json();
                        if (fileData && fileData.content) {
                            const decodedHtml = base64ToUtf8(fileData.content);
                            const parsed = parseEmbeddedDataFromHtml(decodedHtml);
                            if (parsed) return parsed;
                        }
                    }
                } catch (e) {
                    console.warn("GitHub API background check skipped:", e);
                }
            }

            // 2. Fetch fresh index.html directly from host server bypassing HTTP cache
            if (window.location.protocol.startsWith('http')) {
                try {
                    const sep = window.location.search ? '&' : '?';
                    const freshUrl = `${window.location.pathname}${window.location.search}${sep}_nocache=${Date.now()}`;
                    const res = await fetch(freshUrl, {
                        cache: 'no-store',
                        headers: {
                            'Cache-Control': 'no-cache, no-store, must-revalidate',
                            'Pragma': 'no-cache'
                        }
                    });
                    if (res.ok) {
                        const freshHtml = await res.text();
                        const parsed = parseEmbeddedDataFromHtml(freshHtml);
                        if (parsed) return parsed;
                    }
                } catch (e) {
                    console.warn("Server background update check skipped:", e);
                }
            }

            return null;
        }

        async function syncLatestDataFromServer(force = false) {
            const now = Date.now();
            if (isCheckingRemoteUpdate) return false;
            if (!force && (now - lastRemoteCheckTime < 15000)) return false;

            isCheckingRemoteUpdate = true;
            lastRemoteCheckTime = now;

            try {
                const remoteBundle = await fetchRemoteFlashcardsBundle();
                if (!remoteBundle) return false;

                const { version: remoteVersion, lessons: remoteLessons } = remoteBundle;
                const serverChanged = remoteVersion !== lastKnownRemoteVersion;
                const isNewerThanCurrent = remoteVersion > currentDataVersion;

                if (serverChanged && (isNewerThanCurrent || currentDataVersion === lastKnownRemoteVersion)) {
                    // Avoid disrupting active recording or active card editing
                    if (isRecording || editingLessonId !== null) {
                        return false;
                    }

                    lessons = remoteLessons;
                    currentDataVersion = remoteVersion;
                    lastKnownRemoteVersion = remoteVersion;

                    await dbSet('lessonsData', {
                        version: remoteVersion,
                        lastSyncedEmbeddedVersion: remoteVersion,
                        lessons
                    });

                    renderTopics();
                    populateTopicDropdowns();
                    if (isAdminView) {
                        renderAdminLessons();
                    }
                    showToast("Updated with latest flashcards!");
                    return true;
                }
            } finally {
                isCheckingRemoteUpdate = false;
            }
            return false;
        }

        async function initStorage() {
            const savedBundle = await dbGet('lessonsData');
            const prevSyncedEmbedded = (savedBundle && typeof savedBundle.lastSyncedEmbeddedVersion === 'number')
                ? savedBundle.lastSyncedEmbeddedVersion
                : null;

            if (savedBundle && Array.isArray(savedBundle.lessons)) {
                const embeddedUpdated = prevSyncedEmbedded !== null && EMBEDDED_VERSION !== prevSyncedEmbedded;
                if (!embeddedUpdated && savedBundle.version > EMBEDDED_VERSION) {
                    lessons = savedBundle.lessons;
                    currentDataVersion = savedBundle.version;
                    lastKnownRemoteVersion = prevSyncedEmbedded !== null ? prevSyncedEmbedded : EMBEDDED_VERSION;
                } else {
                    lessons = [...EMBEDDED_LESSONS];
                    currentDataVersion = EMBEDDED_VERSION;
                    lastKnownRemoteVersion = EMBEDDED_VERSION;
                    await dbSet('lessonsData', {
                        version: EMBEDDED_VERSION,
                        lastSyncedEmbeddedVersion: EMBEDDED_VERSION,
                        lessons
                    });
                }
            } else {
                lessons = [...EMBEDDED_LESSONS];
                currentDataVersion = EMBEDDED_VERSION;
                lastKnownRemoteVersion = EMBEDDED_VERSION;
                await dbSet('lessonsData', {
                    version: EMBEDDED_VERSION,
                    lastSyncedEmbeddedVersion: EMBEDDED_VERSION,
                    lessons
                });
            }

            const savedHandle = await dbGet('localIndexFileHandle');
            if (savedHandle) {
                const alreadyGranted = await ensureLocalFilePermission(savedHandle, false);
                if (alreadyGranted) {
                    localFileHandle = savedHandle;
                } else {
                    pendingFileHandle = savedHandle;
                }
            }

            loadGitHubFormFields();
            renderTopics();
            populateTopicDropdowns();

            // Automatically check server / GitHub for newer flashcards right after initial render
            syncLatestDataFromServer(true);
        }

