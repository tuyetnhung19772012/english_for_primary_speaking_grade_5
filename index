            const selectRenameTarget = document.getElementById('selectRenameTarget');

            const previousSelect = keepSelectedTopic || selectTopic.value;
            const previousFilter = keepFilterValue !== null ? keepFilterValue : filterAdminTopic.value;
            const previousRenameTarget = selectRenameTarget.value;

            const topics = getUniqueTopics();

            selectTopic.innerHTML = '';
            topics.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t;
                opt.textContent = t;
                selectTopic.appendChild(opt);
            });

            const newOpt = document.createElement('option');
            newOpt.value = "__NEW__";
            newOpt.textContent = "+ Create new deck...";
            selectTopic.appendChild(newOpt);

            if (previousSelect && (topics.includes(previousSelect) || previousSelect === "__NEW__")) {
                selectTopic.value = previousSelect;
            } else if (topics.length > 0) {
                selectTopic.value = topics[0];
            } else {
                selectTopic.value = "__NEW__";
            }
            toggleNewTopicInput();

            filterAdminTopic.innerHTML = '<option value="ALL">All Decks</option>';
            topics.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t.toLowerCase();
                opt.textContent = t;
                filterAdminTopic.appendChild(opt);
            });
            if (Array.from(filterAdminTopic.options).some(o => o.value === previousFilter)) {
                filterAdminTopic.value = previousFilter;
            }

            selectRenameTarget.innerHTML = '';
            topics.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t;
                opt.textContent = t;
                selectRenameTarget.appendChild(opt);
            });
            if (topics.includes(previousRenameTarget)) {
