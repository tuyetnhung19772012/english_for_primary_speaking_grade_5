        async function ensureLocalFilePermission(handle, requestIfNeeded = true) {
            if (!handle) return false;
            try {
                if ((await handle.queryPermission({ mode: 'readwrite' })) === 'granted') {
                    return true;
                }
                if (requestIfNeeded && (await handle.requestPermission({ mode: 'readwrite' })) === 'granted') {
                    return true;
                }
            } catch (e) {
                console.warn("Permission check failed:", e);
            }
            return false;
        }

        async function writeLessonsToLocalFile(version, customActionMsg = null, requestPermissionIfNeeded = true) {
            let handle = localFileHandle || pendingFileHandle;
            if (!handle) return false;

            const granted = await ensureLocalFilePermission(handle, requestPermissionIfNeeded);
            if (!granted) {
                pendingFileHandle = handle;
                localFileHandle = null;
                updateSyncStatusUI();
                showToast('Permission needed — click "Resume Auto-Save" to write to index.html.', "warning");
                return false;
            }

            localFileHandle = handle;
            pendingFileHandle = null;
            updateSyncStatusUI();

            try {
                const file = await localFileHandle.getFile();
                let rawHtml = await file.text();
                if (!rawHtml || !rawHtml.includes('/* __DATA_START__ */')) {
                    rawHtml = INITIAL_CLEAN_HTML;
                }

                const updatedHtml = buildUpdatedHtmlString(rawHtml, version);
                if (!updatedHtml) {
                    throw new Error("Target file is missing __DATA_START__ markers.");
                }

                const writable = await localFileHandle.createWritable();
                await writable.write(updatedHtml);
                await writable.close();

                const fname = localFileHandle.name || 'index.html';
                showToast(customActionMsg ? `${customActionMsg} Saved directly into ${fname}!` : `Saved directly into ${fname}!`);
                return true;
            } catch (err) {
                console.error("Direct File Write Error:", err);
                showToast(`Could not write to file: ${err.message}`, "warning");
                return false;
            }
        }

        async function pushLessonsToGitHub(version, customActionMsg = null, silentIfUnconfigured = false) {
            const cfg = getGitHubConfig();
            if (!cfg || !cfg.owner || !cfg.repo || !cfg.token) {
                if (!silentIfUnconfigured) {
                    showToast(customActionMsg ? `${customActionMsg} (Saved in browser — link index.html or download file)` : "Saved in browser — link index.html or download file!", "warning");
                }
                return false;
            }

            if (isSyncingToGitHub) return false;
            isSyncingToGitHub = true;
            if (!localFileHandle) {
                showToast("Syncing directly to GitHub...", "syncing");
            }

            const apiUrl = `https://api.github.com/repos/${encodeURIComponent(cfg.owner)}/${encodeURIComponent(cfg.repo)}/contents/${cfg.path.replace(/^\/+/, '')}`;
            const headers = {
                'Authorization': `Bearer ${cfg.token}`,
                'Accept': 'application/vnd.github+json',
                'Content-Type': 'application/json'
            };

            try {
                const getRes = await fetch(`${apiUrl}?ref=${encodeURIComponent(cfg.branch || 'main')}&t=${Date.now()}`, { headers });
                if (!getRes.ok) {
                    const errData = await getRes.json().catch(() => ({}));
                    throw new Error(errData.message || `GitHub HTTP ${getRes.status}`);
                }
                const fileData = await getRes.json();
                const currentHtml = base64ToUtf8(fileData.content);
                const updatedHtml = buildUpdatedHtmlString(currentHtml, version);

                if (!updatedHtml) {
                    throw new Error("Could not locate data markers in target HTML file.");
                }

                const putRes = await fetch(apiUrl, {
                    method: 'PUT',
                    headers,
                    body: JSON.stringify({
                        message: `Update flashcards (${lessons.length} cards) via Teacher's Corner`,
                        content: utf8ToBase64(updatedHtml),
                        sha: fileData.sha,
                        branch: cfg.branch || 'main'
                    })
                });

                if (!putRes.ok) {
                    const errData = await putRes.json().catch(() => ({}));
                    throw new Error(errData.message || `Commit failed (${putRes.status})`);
                }

                isSyncingToGitHub = false;
                updateSyncStatusUI();
                showToast(customActionMsg ? `${customActionMsg} Synced to GitHub!` : "Synced to GitHub!");
                return true;
            } catch (err) {
                isSyncingToGitHub = false;
                console.error("GitHub Sync Error:", err);
                showToast(`GitHub sync failed: ${err.message}`, "warning");
                return false;
            }
        }

