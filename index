        function parseEmbeddedDataFromHtml(rawHtml) {
            if (!rawHtml || !rawHtml.includes('/* __DATA_START__ */')) return null;
            const blockMatch = rawHtml.match(/\/\* __DATA_START__ \*\/([\s\S]*?)\/\* __DATA_END__ \*\//);
            if (!blockMatch) return null;

            const block = blockMatch[1];
            const verMatch = block.match(/const\s+EMBEDDED_VERSION\s*=\s*(\d+)\s*;/);
            const lessonsMatch = block.match(/const\s+EMBEDDED_LESSONS\s*=\s*(\[[\s\S]*\])\s*;/);
            if (!verMatch || !lessonsMatch) return null;

            try {
                const parsedVersion = Number(verMatch[1]);
                const rawJson = lessonsMatch[1].replace(/<\\\/script>/gi, '<' + '/script>');
                const parsedLessons = JSON.parse(rawJson);
                if (Number.isFinite(parsedVersion) && Array.isArray(parsedLessons)) {
                    return { version: parsedVersion, lessons: parsedLessons };
                }
            } catch (e) {
                console.warn("Failed to parse remote embedded data:", e);
            }
            return null;
        }

