                const colors = ['bg-indigo-500', 'bg-emerald-500', 'bg-sky-500', 'bg-rose-500', 'bg-amber-500'];
                const cardLabel = topic.count === 1 ? '1 card' : `${topic.count} cards`;
                const card = document.createElement('div');
                card.className = "bg-white rounded-3xl overflow-hidden shadow-md border border-slate-100 cursor-pointer flex flex-col hover:shadow-xl hover:-translate-y-1 transition-all duration-300";
                card.onclick = () => openQuizSession(topic.title);
                card.innerHTML = `
                    <div class="h-44 sm:h-48 overflow-hidden relative group bg-slate-100">
                        <img src="${topic.image}" onerror="this.src='${FALLBACK_IMAGE}'" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 to-transparent"></div>
                        <span class="absolute bottom-3 left-4 ${colors[idx % colors.length]} text-white px-3 py-1 rounded-lg text-xs font-black shadow">
                            ${cardLabel}
                        </span>
                    </div>
                    <div class="p-5 text-center">
                        <h3 class="text-xl font-black text-slate-800">${topic.title}</h3>
                    </div>`;
                topicsGrid.appendChild(card);
            });
            lucide.createIcons();
        }

        /* =======================================================
           8. 5-STEP SPEAKING FLOW:
              1. Show Image & Question
              2. Record Student's Answer
              3. Grade Student's Answer
              4. Reveal Sample Answer for Comparison
              5. Show Total Average Score after Topic Completion
           ======================================================= */
        let globalMediaStream = null;
        let mediaRecorder = null;
        let recognition = null;
        let isRecording = false;
        let finalSpokenText = "";

        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (SpeechRecognition) {
            recognition = new SpeechRecognition();
            recognition.continuous = false;
            recognition.interimResults = true;
            recognition.lang = 'en-US';
            recognition.onresult = (event) => {
                let transcript = '';
                for (let i = 0; i < event.results.length; i++) {
                    transcript += event.results[i][0].transcript;
                }
                finalSpokenText = transcript;
            };
        }

        function playTTS(text) {
            if (!('speechSynthesis' in window) || !text) return;
            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'en-US';
            utterance.rate = 0.85;
            utterance.pitch = 1.08;
            window.speechSynthesis.speak(utterance);
        }

        function showBottomPanel(state) {
            document.getElementById('panelControls').classList.add('hidden');
            document.getElementById('panelControls').classList.remove('flex');
            document.getElementById('panelResults').classList.add('hidden');
            document.getElementById('panelResults').classList.remove('flex');

            if (state === 'controls') {
                document.getElementById('panelControls').classList.remove('hidden');
                document.getElementById('panelControls').classList.add('flex');
            } else if (state === 'results') {
                document.getElementById('panelResults').classList.remove('hidden');
                document.getElementById('panelResults').classList.add('flex');
            }
        }

        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }

        function openQuizSession(topicTitle) {
            const filterKey = topicTitle.trim().toLowerCase();
            currentQuizWords = shuffleArray(lessons.filter(l => l.topic.trim().toLowerCase() === filterKey));
            if (currentQuizWords.length === 0) return;

            currentQuizIndex = 0;
            sessionScores = [];
            document.getElementById('summaryTopicName').textContent = currentQuizWords[0].topic;
            document.getElementById('detailTitle').textContent = currentQuizWords[0].topic;

            document.getElementById('mainContent').classList.add('hidden');
            document.getElementById('lessonDetail').classList.remove('hidden');
            document.getElementById('lessonDetail').classList.add('flex');
            document.getElementById('finishScreen').classList.add('hidden');
            document.getElementById('finishScreen').classList.remove('flex');

            renderCurrentCard();
        }

        // Step 1: Display Image & Question immediately; hide Sample Answer until student records
        function renderCurrentCard() {
            const item = currentQuizWords[currentQuizIndex];
            const cardImg = document.getElementById('cardImage');
            cardImg.onerror = () => { cardImg.src = FALLBACK_IMAGE; };
            cardImg.src = item.image;

            const questionEl = document.getElementById('cardQuestion');
            questionEl.textContent = item.question;
            questionEl.className = "text-xl sm:text-2xl font-extrabold leading-snug transition-all duration-300";

            document.getElementById('cardAnswer').textContent = item.text;
            document.getElementById('quizProgress').textContent = `${currentQuizIndex + 1} / ${currentQuizWords.length}`;

            // Hide sample answer before student speaks
            document.getElementById('answerContainer').classList.add('hidden');

            const badge = document.getElementById('cardStepBadge');
            badge.textContent = "Step 1: Listen & Answer";
            badge.className = "absolute top-3 right-3 bg-indigo-600/85 backdrop-blur-sm text-white text-xs font-extrabold px-3 py-1 rounded-full shadow-sm";

            showBottomPanel('controls');
            resetRecordButton();

            document.getElementById('nextBtnText').textContent =
                (currentQuizIndex === currentQuizWords.length - 1) ? "See Total Score" : "Next Card";
            lucide.createIcons();

            // Automatically read the question aloud in Step 1
            playTTS(item.question);
        }

        // Listen to Question buttons
        document.getElementById('btnListenQuestion').addEventListener('click', () => {
            playTTS(currentQuizWords[currentQuizIndex].question);
        });
        document.getElementById('btnReplayQuestionInline').addEventListener('click', () => {
            playTTS(currentQuizWords[currentQuizIndex].question);
        });

        // Listen to Sample Answer buttons (visible in Step 4 after recording)
        document.getElementById('btnListenSample').addEventListener('click', () => {
            playTTS(currentQuizWords[currentQuizIndex].text);
        });
        document.getElementById('btnListenSampleInline').addEventListener('click', () => {
            playTTS(currentQuizWords[currentQuizIndex].text);
        });

        // Step 2: Record Student's Answer
        document.getElementById('btnRecord').addEventListener('click', async () => {
            if (!isRecording) await startRecording();
            else stopRecording();
        });

        async function startRecording() {
            if (!SpeechRecognition) {
                alert("Your browser does not support speech recognition. Please use Google Chrome or Microsoft Edge!");
                return;
            }
            try {
                window.speechSynthesis.cancel();
                if (!globalMediaStream) {
                    globalMediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                }
                mediaRecorder = new MediaRecorder(globalMediaStream);
                finalSpokenText = "";

                mediaRecorder.onstop = () => {
                    setTimeout(processResults, 450);
                };

                mediaRecorder.start();
                recognition.start();

                isRecording = true;
                const btn = document.getElementById('btnRecord');
                btn.classList.add('is-recording');
                btn.classList.replace('bg-emerald-500', 'bg-rose-500');
                document.getElementById('recordText').textContent = "Recording... Tap Stop";
                document.getElementById('micIcon').setAttribute('data-lucide', 'square');

                const badge = document.getElementById('cardStepBadge');
                badge.textContent = "Step 2: Recording Answer...";
                badge.className = "absolute top-3 right-3 bg-rose-600/90 backdrop-blur-sm text-white text-xs font-extrabold px-3 py-1 rounded-full shadow-sm";

                lucide.createIcons();
            } catch (err) {
                alert("Please allow microphone access in your browser to record!");
            }
        }

        function stopRecording() {
            if (mediaRecorder && mediaRecorder.state !== 'inactive') mediaRecorder.stop();
            if (recognition) {
                try { recognition.stop(); } catch (e) {}
            }
            isRecording = false;
            document.getElementById('recordText').textContent = "Scoring...";
        }

        function resetRecordButton() {
            const btn = document.getElementById('btnRecord');
            btn.classList.remove('is-recording');
            btn.classList.replace('bg-rose-500', 'bg-emerald-500');
            document.getElementById('recordText').textContent = "Record Answer";
            document.getElementById('micIcon').setAttribute('data-lucide', 'mic');
            lucide.createIcons();
        }

        function normalizeText(str) {
            return str
                .toLowerCase()
                .replace(/i'm/g, "i am")
                .replace(/it's/g, "it is")
                .replace(/he's/g, "he is")
                .replace(/she's/g, "she is")
                .replace(/we're/g, "we are")
                .replace(/they're/g, "they are")
                .replace(/don't/g, "do not")
                .replace(/doesn't/g, "does not")
                .replace(/can't/g, "cannot")
                .replace(/[.,?!'"-]/g, ' ')
                .trim();
        }

        // Steps 3 & 4: Grade Student's Answer & Reveal Sample Answer for Comparison
        function processResults() {
            resetRecordButton();
            const targetWordFull = currentQuizWords[currentQuizIndex].text;
            const rawDisplayWords = targetWordFull.trim().split(/\s+/);
            const normalizedTargetWords = normalizeText(targetWordFull).split(/\s+/).filter(Boolean);
            const spokenWords = normalizeText(finalSpokenText).split(/\s+/).filter(Boolean);

            let correctCount = 0;
            normalizedTargetWords.forEach(w => {
                if (spokenWords.includes(w)) correctCount++;
            });

            const wordAnalysis = document.getElementById('wordAnalysis');
            wordAnalysis.innerHTML = '';

            rawDisplayWords.forEach(rawWord => {
                const parts = normalizeText(rawWord).split(/\s+/).filter(Boolean);
                const isWordMatched = parts.length > 0 && parts.every(p => spokenWords.includes(p));
                const span = document.createElement('span');
                span.textContent = rawWord;
                span.className = isWordMatched ? "text-emerald-600" : "text-rose-500";
                wordAnalysis.appendChild(span);
            });

            const transcriptEl = document.getElementById('spokenTranscriptText');
            transcriptEl.textContent = finalSpokenText.trim()
                ? `You said: "${finalSpokenText.trim()}"`
                : "No speech detected — tap Try Again to speak";

            const score = normalizedTargetWords.length > 0
                ? Math.round((correctCount / normalizedTargetWords.length) * 100)
                : 0;

            sessionScores.push({
                question: currentQuizWords[currentQuizIndex].question,
                text: targetWordFull,
                score: score
            });

            const scoreBadge = document.getElementById('scoreBadge');
            scoreBadge.textContent = score + "%";
            if (score === 100) scoreBadge.className = "bg-emerald-500 text-white font-black text-xl sm:text-2xl px-4 py-2 rounded-xl shrink-0 shadow-sm";
            else if (score >= 50) scoreBadge.className = "bg-amber-500 text-white font-black text-xl sm:text-2xl px-4 py-2 rounded-xl shrink-0 shadow-sm";
            else scoreBadge.className = "bg-rose-500 text-white font-black text-xl sm:text-2xl px-4 py-2 rounded-xl shrink-0 shadow-sm";

            // Step 4: Reveal Sample Answer on the card for direct comparison
            const questionEl = document.getElementById('cardQuestion');
            questionEl.className = "text-base sm:text-lg font-bold text-slate-500 leading-snug transition-all duration-300";
            document.getElementById('answerContainer').classList.remove('hidden');

            const stepBadge = document.getElementById('cardStepBadge');
            stepBadge.textContent = "Step 4: Compare with Sample";
            stepBadge.className = "absolute top-3 right-3 bg-emerald-600/90 backdrop-blur-sm text-white text-xs font-extrabold px-3 py-1 rounded-full shadow-sm";

            showBottomPanel('results');
            lucide.createIcons();
        }

        // Retry current card: hide sample answer again and return to Step 1 & 2
        document.getElementById('btnRetry').addEventListener('click', () => {
            window.speechSynthesis.cancel();
            if (sessionScores.length > currentQuizIndex) {
                sessionScores.pop();
            }

            const questionEl = document.getElementById('cardQuestion');
            questionEl.className = "text-xl sm:text-2xl font-extrabold leading-snug transition-all duration-300";
            document.getElementById('answerContainer').classList.add('hidden');

            const stepBadge = document.getElementById('cardStepBadge');
            stepBadge.textContent = "Step 1: Listen & Answer";
            stepBadge.className = "absolute top-3 right-3 bg-indigo-600/85 backdrop-blur-sm text-white text-xs font-extrabold px-3 py-1 rounded-full shadow-sm";

            resetRecordButton();
            showBottomPanel('controls');
        });

        // Advance to next card or Step 5 Total Score summary
        document.getElementById('btnNextWord').addEventListener('click', () => {
            window.speechSynthesis.cancel();
            if (currentQuizIndex < currentQuizWords.length - 1) {
                currentQuizIndex++;
                renderCurrentCard();
            } else {
                renderSummaryModule();
                document.getElementById('finishScreen').classList.remove('hidden');
                document.getElementById('finishScreen').classList.add('flex');
            }
        });

        // Step 5: Render Total Average Score for the completed deck
        function renderSummaryModule() {
            let total = 0;
            sessionScores.forEach(item => total += item.score);
            const averageScore = Math.round(total / sessionScores.length) || 0;

            const circle = document.getElementById('summaryScoreCircle');
            circle.textContent = averageScore + "%";
            if (averageScore >= 80) circle.className = "w-32 h-32 rounded-full flex items-center justify-center text-4xl font-black text-white shadow-xl bg-emerald-400 ring-8 ring-emerald-100";
            else if (averageScore >= 50) circle.className = "w-32 h-32 rounded-full flex items-center justify-center text-4xl font-black text-white shadow-xl bg-amber-400 ring-8 ring-amber-100";
            else circle.className = "w-32 h-32 rounded-full flex items-center justify-center text-4xl font-black text-white shadow-xl bg-rose-400 ring-8 ring-rose-100";
        }

        function closeLesson() {
            window.speechSynthesis.cancel();
            if (isRecording) stopRecording();
            if (globalMediaStream) {
                globalMediaStream.getTracks().forEach(track => track.stop());
                globalMediaStream = null;
            }
            document.getElementById('lessonDetail').classList.add('hidden');
            document.getElementById('lessonDetail').classList.remove('flex');
            document.getElementById('mainContent').classList.remove('hidden');
            renderTopics();
        }

        // Initialize app
        initStorage();
    </script>
</body>
</html>
