<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grade 5 English Flashcards</title>
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: { extend: { fontFamily: { sans: ['Nunito', 'sans-serif'] } } }
        }
    </script>
    <style data-app-style="true">
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

        /* Recording button pulse effect */
        @keyframes pulse-recording {
            0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            70% { box-shadow: 0 0 0 14px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }
        .is-recording { animation: pulse-recording 1.5s infinite; background-color: #ef4444 !important; color: white !important; }

        /* Smooth sample answer reveal animation */
        @keyframes revealUp {
            from { opacity: 0; transform: translateY(10px) scale(0.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .animate-reveal { animation: revealUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

        /* Shake animation for wrong password */
        @keyframes shakeX {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }
        .animate-shake { animation: shakeX 0.35s ease-in-out; }

        /* Subtle copyright watermark across all views */
        .copyright-watermark {
            position: fixed;
            bottom: 10px;
            right: 14px;
            z-index: 60;
            pointer-events: none;
            user-select: none;
            -webkit-user-select: none;
            font-family: 'Nunito', sans-serif;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.02em;
            color: rgba(71, 85, 105, 0.42);
            text-shadow: 0 1px 1px rgba(255, 255, 255, 0.75);
            white-space: nowrap;
        }
        @media (max-width: 640px) {
            .copyright-watermark {
                font-size: 10px;
                bottom: 6px;
                right: 10px;
            }
        }
        @media print {
            .copyright-watermark {
                position: fixed;
                bottom: 8px;
                right: 12px;
                color: rgba(71, 85, 105, 0.45) !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body class="bg-sky-50 min-h-screen flex flex-col font-sans m-0 p-0 select-none">

    <!-- Main Navbar -->
    <nav class="bg-white shadow-sm px-4 sm:px-6 py-3.5 flex justify-between items-center z-10 shrink-0">
        <div class="flex items-center gap-3">
            <div class="bg-indigo-500 p-2 rounded-xl text-white shadow-sm"><i data-lucide="layers" class="w-5 h-5"></i></div>
            <h1 class="text-xl sm:text-2xl font-black text-indigo-600 tracking-tight">English Flashcards 5</h1>
        </div>
        <div class="flex items-center gap-2">
            <button id="btnLockAdmin" class="hidden items-center gap-1.5 px-3 py-2 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 rounded-xl font-bold transition-colors text-xs sm:text-sm" title="Lock Teacher's Corner">
                <i data-lucide="lock" class="w-4 h-4"></i> <span class="hidden sm:inline">Lock</span>
            </button>
            <button id="btnToggleAdmin" class="flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold transition-colors text-sm sm:text-base">
                <i data-lucide="settings" class="w-4 h-4"></i><span id="toggleAdminText">Teacher's Corner</span>
            </button>
        </div>
    </nav>

    <!-- STUDENT DASHBOARD & TEACHER'S CORNER -->
    <main id="mainContent" class="flex-grow w-full max-w-6xl mx-auto p-5 sm:p-6">
        
        <!-- 1. TOPIC SELECTION DASHBOARD -->
        <div id="studentDashboard">
            <div class="text-center mb-8 mt-2">
                <h2 class="text-3xl sm:text-4xl font-black text-slate-800 mb-2">Welcome to Grade 5! 🚀</h2>
                <p class="text-slate-500 font-semibold">Choose a flashcard deck to practice Q&amp;A and pronunciation.</p>
            </div>
            <div id="topicsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pb-8"></div>
        </div>

        <!-- 2. TEACHER'S CORNER -->
        <div id="adminPanel" class="hidden w-full pb-10">
            
            <!-- DIRECT FILE SAVE & GITHUB SYNC BAR -->
            <div class="max-w-5xl mx-auto mb-6 bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-5 py-4 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3.5">
                    <div class="flex items-center gap-3">
                        <span id="syncStatusDot" class="w-3 h-3 rounded-full bg-amber-400 shrink-0"></span>
                        <div>
                            <p id="syncStatusTitle" class="text-sm font-black text-slate-800">Direct Save to index.html: Not Linked</p>
                            <p id="syncStatusDesc" class="text-xs font-semibold text-slate-500">Click "Link index.html (Auto-Save)" to write every edit directly into this file on your computer.</p>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 shrink-0">
                        <button type="button" id="btnLinkLocalFile" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs sm:text-sm rounded-xl flex items-center gap-1.5 shadow-sm transition-colors" title="Select your local index.html file so all edits save directly into it">
                            <i data-lucide="file-check" class="w-4 h-4"></i> <span id="btnLinkLocalFileText">Link index.html (Auto-Save)</span>
                        </button>
                        <button type="button" id="btnSaveLocalNow" class="hidden px-3.5 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 font-extrabold text-xs sm:text-sm rounded-xl items-center gap-1.5 transition-colors" title="Write all current cards directly into your linked index.html file now">
                            <i data-lucide="save" class="w-4 h-4"></i> <span id="btnSaveLocalNowText">Save Now</span>
                        </button>
                        <button type="button" id="btnUnlinkLocalFile" class="hidden px-2.5 py-2 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 font-bold text-xs rounded-xl items-center gap-1 transition-colors" title="Unlink local index.html file">
                            <i data-lucide="unlink" class="w-3.5 h-3.5"></i> <span>Unlink</span>
                        </button>
                        <button type="button" id="btnDownloadHtml" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-extrabold text-xs sm:text-sm rounded-xl flex items-center gap-1.5 transition-colors" title="Download a fresh self-contained index.html file">
                            <i data-lucide="download" class="w-4 h-4"></i> <span>Download index.html</span>
                        </button>
                        <button type="button" id="btnToggleGhSetup" class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold text-xs sm:text-sm rounded-xl flex items-center gap-1.5 shadow-sm transition-colors">
                            <i data-lucide="github" class="w-4 h-4"></i> <span id="btnToggleGhSetupText">GitHub Sync</span>
                        </button>
                    </div>
                </div>

                <!-- COLLAPSIBLE GITHUB CONFIGURATION FORM -->
                <div id="ghSetupDrawer" class="hidden border-t border-slate-100 bg-slate-50/80 px-5 py-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
                        <div>
                            <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">GitHub Username</label>
                            <input type="text" id="ghOwner" placeholder="e.g., your-username" class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-indigo-400 select-text">
                        </div>
                        <div>
                            <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">Repository Name</label>
                            <input type="text" id="ghRepo" placeholder="e.g., english-flashcards" class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-indigo-400 select-text">
                        </div>
                        <div>
                            <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">Branch &amp; File</label>
                            <div class="flex gap-1.5">
                                <input type="text" id="ghBranch" value="main" placeholder="main" class="w-1/2 px-2.5 py-2 rounded-xl border border-slate-300 bg-white text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-indigo-400 select-text">
                                <input type="text" id="ghPath" value="index.html" placeholder="index.html" class="w-1/2 px-2.5 py-2 rounded-xl border border-slate-300 bg-white text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-indigo-400 select-text">
                            </div>
                        </div>
                        <div class="lg:col-span-2">
                            <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">Personal Access Token (Stored locally only)</label>
                            <div class="flex gap-2">
                                <input type="password" id="ghToken" placeholder="ghp_... or github_pat_..." class="flex-1 px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-indigo-400 select-text">
                                <button type="button" id="btnSaveGhConfig" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs rounded-xl shadow-sm shrink-0 transition-colors">
                                    Connect &amp; Sync
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="mt-2.5 flex flex-wrap items-center justify-between gap-2 text-[11px] font-semibold text-slate-500">
                        <span>Your token is saved only in this browser's local storage and is never uploaded to GitHub.</span>
                        <button type="button" id="btnDisconnectGh" class="hidden text-rose-600 hover:underline font-bold">Disconnect GitHub</button>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
                <!-- LEFT COLUMN: ADD / EDIT FLASHCARD FORM -->
                <div class="bg-white p-6 sm:p-8 rounded-3xl shadow-lg border border-slate-100 h-fit">
                    <div class="flex items-center justify-between mb-5">
                        <h2 id="formHeading" class="text-xl font-black text-slate-800 flex items-center gap-2">
                            <i data-lucide="plus-circle" id="formHeadingIcon" class="text-emerald-500"></i>
                            <span id="formHeadingText">Add New Flashcard</span>
                        </h2>
                        <button type="button" id="btnCancelEdit" class="hidden text-xs font-extrabold text-slate-500 hover:text-rose-600 bg-slate-100 hover:bg-rose-50 px-3 py-1.5 rounded-xl transition-colors">
                            Cancel Edit
                        </button>
                    </div>
                    <form id="addLessonForm" class="space-y-4">
                        <!-- Field 1: Topic Dropdown -->
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Topic / Deck</label>
                            <div class="relative">
                                <select id="selectTopic" class="w-full px-4 py-3 pr-10 rounded-xl border border-slate-300 font-bold text-slate-800 bg-slate-50 outline-none focus:ring-2 focus:ring-emerald-400 appearance-none cursor-pointer">
                                </select>
                                <i data-lucide="chevron-down" class="w-5 h-5 text-slate-500 absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                            </div>
                            <!-- New Topic Input (visible when "+ Create new deck..." is selected) -->
                            <input type="text" id="inputNewTopic" placeholder="Enter new deck name (e.g., My School)..." class="hidden mt-2.5 w-full px-4 py-3 rounded-xl border-2 border-indigo-300 font-bold text-slate-800 bg-indigo-50/40 outline-none focus:ring-2 focus:ring-indigo-400 select-text">
                        </div>

                        <!-- Field 2: Question -->
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Question (Shown in Step 1)</label>
                            <input type="text" id="inputQuestion" required placeholder="e.g., Where do you live?" class="w-full px-4 py-3 rounded-xl border border-slate-300 font-bold bg-slate-50 outline-none focus:ring-2 focus:ring-emerald-400 select-text">
                        </div>

                        <!-- Field 3: Sample Answer -->
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Sample Answer (Shown after recording)</label>
                            <input type="text" id="inputText" required placeholder="e.g., I live in the city." class="w-full px-4 py-3 rounded-xl border border-slate-300 font-bold bg-slate-50 outline-none focus:ring-2 focus:ring-emerald-400 select-text">
                        </div>

                        <!-- Field 4: Image Upload or Clipboard Paste -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label class="block text-xs font-bold text-slate-500 uppercase">Illustration Image</label>
                                <span class="text-[11px] font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-md">Supports Ctrl + V paste</span>
                            </div>
                            
                            <input type="file" id="inputImageFile" accept="image/*" class="hidden">
                            
                            <div id="imageDropZone" tabindex="0" class="relative w-full h-44 rounded-2xl border-2 border-dashed border-slate-300 hover:border-emerald-400 focus:border-indigo-500 bg-slate-50 hover:bg-emerald-50/30 transition-all cursor-pointer flex flex-col items-center justify-center overflow-hidden group outline-none">
                                
                                <!-- Empty State -->
                                <div id="imagePlaceholder" class="flex flex-col items-center justify-center p-4 text-center">
                                    <div class="bg-white p-3 rounded-2xl shadow-sm border border-slate-200 mb-2.5 group-hover:scale-105 transition-transform">
                                        <i data-lucide="image-plus" class="w-7 h-7 text-emerald-600"></i>
                                    </div>
                                    <p class="text-sm font-extrabold text-slate-700">Click to upload or press <kbd class="px-1.5 py-0.5 bg-white border border-slate-300 rounded text-xs font-black text-indigo-600">Ctrl + V</kbd></p>
                                    <p class="text-xs font-semibold text-slate-400 mt-1">Drag &amp; drop an image here</p>
                                </div>

                                <!-- Preview State -->
                                <img id="imagePreview" src="" alt="Preview" class="hidden w-full h-full object-cover">
                                <div id="imageOverlayActions" class="hidden absolute inset-0 bg-slate-900/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                                    <span class="bg-white text-slate-800 font-extrabold text-xs px-3 py-2 rounded-xl shadow flex items-center gap-1.5">
                                        <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Change image (or Ctrl+V)
                                    </span>
                                    <button type="button" id="btnClearImage" class="bg-rose-500 hover:bg-rose-600 text-white font-extrabold text-xs px-3 py-2 rounded-xl shadow flex items-center gap-1">
                                        <i data-lucide="x" class="w-3.5 h-3.5"></i> Remove
                                    </button>
                                </div>
                            </div>
                        </div>

                        <button type="submit" id="btnSaveCard" class="w-full bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-black py-3.5 rounded-xl transition-all shadow-md flex items-center justify-center gap-2">
                            <i data-lucide="save" class="w-5 h-5"></i>
                            <span id="btnSaveCardText">Save Card</span>
                        </button>
                    </form>
                </div>

                <!-- RIGHT COLUMN: CARD LIBRARY -->
                <div class="bg-white p-6 sm:p-8 rounded-3xl shadow-lg border border-slate-100 flex flex-col h-[630px]">
                    <div class="flex flex-wrap justify-between items-center gap-2 mb-4">
                        <h2 class="text-xl font-black text-slate-800 flex items-center gap-2">
                            <i data-lucide="database" class="text-indigo-500"></i> Card Library (<span id="totalCardsCount">0</span>)
                        </h2>
                        <div class="flex items-center gap-2">
                            <select id="filterAdminTopic" class="text-xs font-bold text-slate-700 bg-slate-100 px-3 py-1.5 rounded-lg outline-none border border-slate-200 cursor-pointer max-w-[150px] truncate">
                                <option value="ALL">All Decks</option>
                            </select>
                            <button type="button" id="btnOpenRenameTopic" title="Rename an existing flashcard deck" class="text-xs font-extrabold text-indigo-600 hover:text-indigo-700 bg-indigo-50 hover:bg-indigo-100 px-2.5 py-1.5 rounded-lg border border-indigo-200 flex items-center gap-1 transition-colors shrink-0">
                                <i data-lucide="pencil" class="w-3.5 h-3.5"></i> <span>Rename Deck</span>
                            </button>
                        </div>
                    </div>

                    <!-- INLINE RENAME DECK PANEL -->
                    <div id="renameTopicPanel" class="hidden mb-4 p-3.5 rounded-2xl bg-indigo-50/80 border border-indigo-200 space-y-2.5 animate-reveal">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-black text-indigo-800 uppercase tracking-wider flex items-center gap-1.5">
                                <i data-lucide="folder-edit" class="w-3.5 h-3.5"></i> Rename Flashcard Deck
                            </span>
                            <button type="button" id="btnCancelRenameTopic" class="text-slate-400 hover:text-slate-600 p-0.5 rounded-md">
                                <i data-lucide="x" class="w-4 h-4"></i>
                            </button>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 uppercase mb-0.5">Select Deck</label>
                                <select id="selectRenameTarget" class="w-full px-3 py-2 rounded-xl border border-indigo-200 bg-white text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-indigo-400 cursor-pointer">
                                </select>
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 uppercase mb-0.5">New Deck Name</label>
                                <input type="text" id="inputRenameTopic" placeholder="Enter new name..." class="w-full px-3 py-2 rounded-xl border border-indigo-200 bg-white text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-indigo-400 select-text">
                            </div>
                        </div>
                        <div class="flex justify-end gap-2 pt-0.5">
                            <button type="button" id="btnCancelRenameTopic2" class="px-3 py-1.5 text-xs font-bold text-slate-600 hover:bg-white rounded-lg transition-colors">
                                Cancel
                            </button>
                            <button type="button" id="btnConfirmRenameTopic" class="px-3.5 py-1.5 text-xs font-black text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm flex items-center gap-1.5 transition-colors">
                                <i data-lucide="check" class="w-3.5 h-3.5"></i> Save Name
                            </button>
                        </div>
                    </div>

                    <div id="adminLessonList" class="flex-grow overflow-y-auto space-y-3 custom-scrollbar pr-2"></div>
                </div>
            </div>
        </div>
    </main>

    <!-- PASSWORD MODAL FOR TEACHER'S CORNER -->
    <div id="passwordModal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4">
        <div id="passwordModalBox" class="bg-white w-full max-w-sm rounded-3xl p-6 sm:p-7 shadow-2xl border border-slate-100 animate-reveal">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2.5">
                    <div class="bg-indigo-100 text-indigo-600 p-2.5 rounded-2xl">
                        <i data-lucide="shield-check" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-black text-slate-800">Teacher's Corner</h3>
                        <p class="text-xs font-semibold text-slate-500">Enter password to continue</p>
                    </div>
                </div>
                <button type="button" id="btnClosePasswordModal" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-xl hover:bg-slate-100 transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <form id="passwordForm" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-1.5">Access Password</label>
                    <div class="relative">
                        <input type="password" id="inputAdminPassword" placeholder="Enter password..." autocomplete="current-password" class="w-full px-4 py-3 pr-11 rounded-xl border border-slate-300 font-bold text-slate-800 bg-slate-50 outline-none focus:ring-2 focus:ring-indigo-500 select-text">
                        <button type="button" id="btnTogglePasswordVisibility" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1" title="Show/Hide password">
                            <i data-lucide="eye" id="passwordEyeIcon" class="w-4 h-4"></i>
                        </button>
                    </div>
                    <p id="passwordErrorMsg" class="hidden text-xs font-bold text-rose-600 mt-1.5 flex items-center gap-1">
                        <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> <span>Incorrect password. Please try again.</span>
                    </p>
                </div>

                <div class="flex items-center gap-2.5 pt-1">
                    <button type="button" id="btnCancelPassword" class="flex-1 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-extrabold text-sm rounded-xl transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="flex-1 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-black text-sm rounded-xl shadow-md shadow-indigo-200 transition-colors">
                        Unlock
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- PRACTICE SCREEN (100% FIXED VIEWPORT - NO SCROLLING) -->
    <div id="lessonDetail" class="fixed inset-0 z-50 bg-sky-50 flex-col hidden h-[100dvh] overflow-hidden">
        
        <!-- Practice Header (Fixed 56px) -->
        <header class="h-14 shrink-0 bg-white shadow-sm flex justify-between items-center px-4 sm:px-6 z-20">
            <button onclick="closeLesson()" class="flex items-center gap-1.5 text-slate-600 hover:text-rose-600 font-extrabold px-2.5 py-1.5 rounded-xl hover:bg-rose-50 transition-colors">
                <i data-lucide="arrow-left" class="w-5 h-5"></i> <span>Exit</span>
            </button>
            <h3 id="detailTitle" class="text-base sm:text-lg font-black text-indigo-600 uppercase tracking-wider text-center truncate px-2">TOPIC NAME</h3>
            <div id="quizProgress" class="font-black text-sky-700 bg-sky-100 px-3.5 py-1 rounded-xl text-sm shrink-0">1 / 4</div>
        </header>

        <!-- Center Stage: Flashcard (Step 1: Image & Question -> Step 4: Sample Answer Comparison) -->
        <div class="flex-1 min-h-0 flex items-center justify-center p-3 sm:p-5 overflow-hidden">
            <div id="flashCard" class="w-full max-w-[430px] h-full max-h-[480px] bg-white rounded-[2rem] shadow-xl border-4 border-white overflow-hidden relative flex flex-col">
                
                <!-- STEP 1: ILLUSTRATION IMAGE -->
                <div class="flex-1 min-h-0 w-full bg-slate-100 relative overflow-hidden">
