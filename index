        function buildUpdatedHtmlString(rawHtml, version) {
            const safeJson = JSON.stringify(lessons, null, 12).replace(/<\/script>/gi, '<\\/script>');
            const newBlock = `/* __DATA_START__ */\n        const EMBEDDED_VERSION = ${version};\n        const EMBEDDED_LESSONS = ${safeJson};\n        /* __DATA_END__ */`;

            const pattern = /\/\* __DATA_START__ \*\/[\s\S]*?\/\* __DATA_END__ \*\//;
            if (pattern.test(rawHtml)) {
                return rawHtml.replace(pattern, () => newBlock);
            }
            return null;
        }

